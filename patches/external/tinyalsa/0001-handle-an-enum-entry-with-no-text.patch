From: uzbforce <oktamovazizbek2010@gmail.com>
Subject: [external/tinyalsa] handle an enum entry with no text

diff --git a/mixer_plugin.c b/mixer_plugin.c
index 673d307..2bbde4c 100644
--- a/mixer_plugin.c
+++ b/mixer_plugin.c
@@ -86,15 +86,22 @@ static int mixer_plug_info_enum(struct snd_control *ctl,
                 struct snd_ctl_elem_info *einfo)
 {
     struct snd_value_enum *val = ctl->value;
+    const char *text = "";
 
     einfo->count = 1;
     einfo->value.enumerated.items = val->items;
 
-    if (einfo->value.enumerated.item > val->items)
+    if (einfo->value.enumerated.item >= val->items)
         return -EINVAL;
 
-    strncpy(einfo->value.enumerated.name,
-            val->texts[einfo->value.enumerated.item],
+    /* A vendor mixer definition may leave an enum entry without text.
+     * Do not pass a NULL source to strncpy(); an empty name keeps ELEM_INFO
+     * usable and lets the remaining controls be enumerated.
+     */
+    if (val->texts && val->texts[einfo->value.enumerated.item])
+        text = val->texts[einfo->value.enumerated.item];
+
+    strncpy(einfo->value.enumerated.name, text,
             sizeof(einfo->value.enumerated.name));
 
     return 0;
