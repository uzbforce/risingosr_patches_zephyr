+ndk::ScopedAStatus Session::sendFodEvent(int pressStatus, int x, int y) {
+    if (!mUdfps || mDevice == nullptr) {
+        return ndk::ScopedAStatus::ok();
+    }
+
+    auto extCmd = reinterpret_cast<int (*)(fingerprint_device_t*, int, int)>(
+            mDevice->reserved[0]);
+    if (extCmd == nullptr) {
+        ALOGE("FOD: HAL has no vendor extCmd in reserved[0]");
+        return ndk::ScopedAStatus::ok();
+    }
+
+    if (pressStatus == kFodPressed) {
+        setHbm(true);
+    }
+
+    tFodReleaseSuppressed = false;
+    int ret = extCmd(mDevice, 1, pressStatus);
+    const bool releaseSuppressed = tFodReleaseSuppressed;
+    if (ret != 0) {
+        ALOGE("FOD: extCmd(press_status, %d) at %d,%d -> %d", pressStatus, x, y, ret);
+        if (pressStatus == kFodPressed) {
+            setHbm(false);
+        }
+        return ndk::ScopedAStatus::ok();
+    }
+
+    ALOGD("FOD: extCmd(press_status, %d) at %d,%d", pressStatus, x, y);
+    if (pressStatus == kFodReleased && !releaseSuppressed) {
+        setHbm(false);
+    }
     return ndk::ScopedAStatus::ok();
 }
 
+bool Session::setHbm(bool enable) {
+    if (!mUdfps) {
+        return false;
+    }
+
+    if (!enable) {
+        ++mHbmState->generation;
+        mHbmState->on = false;
+        setLocalHbm(0);
+        return true;
+    }
+
+    const uint32_t generation = ++mHbmState->generation;
+    mHbmState->on = true;
+
+    // The display's disp_param node is briefly unavailable while the DSI panel
+    // unblanks from screen-off. If the vendor FOD capture starts before the
+    // panel is ready, it captures a black frame and the AOD unlock fails.
+    // Retry the local HBM write until the display is actually ready.
+    const auto deadline = std::chrono::steady_clock::now() + kHbmReadyTimeout;
+    bool ready = false;
+    while (mHbmState->on.load() && mHbmState->generation.load() == generation) {
+        if (setLocalHbm(kLocalHbmWhite1000Nit)) {
+            ready = true;
+            break;
+        }
+        if (std::chrono::steady_clock::now() >= deadline) {
+            break;
+        }
+        std::this_thread::sleep_for(kHbmRetryInterval);
+    }
+
+    if (!ready) {
+        ALOGE("FOD: local HBM not ready, giving up");
+        mHbmState->on = false;
+        return false;
+    }
+
+    ALOGD("FOD: local HBM 1000-nit");
+    auto state = mHbmState;
+    std::thread([state, generation]() {
+        std::this_thread::sleep_for(kHbmWatchdog);
+        if (state->on.load() && state->generation.load() == generation) {
+            ALOGE("FOD: no release or HAL completion, forcing local HBM off");
+            setLocalHbm(0);
+            state->on = false;
+        }
+    }).detach();
+    return true;
+}
