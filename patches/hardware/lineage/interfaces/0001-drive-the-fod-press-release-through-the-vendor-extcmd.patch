 namespace aidl::android::hardware::biometrics::fingerprint {
 
+namespace {
+
+// Vendor FOD control.
+//
+// Xiaomi's libhardware modules keep a vendor extension in
+// fingerprint_device_t::reserved[0] - the slot AOSP reserves for precisely this
+// kind of out-of-tree addition. fingerprint.goodix_fod.so installs its handler
+// there (struct offset 0xd0) and the handler is what arms the FOD capture:
+//
+//   cmd=1 param=1 -> logs "HBM and Green spot ready", notifies ACQUIRED(1002)
+//                    and posts the FOD press event
+//   cmd=1 param=0 -> notifies ACQUIRED(1003) and posts the release
+//
+// This is the channel the stock HIDL 2.1 HAL could never provide:
+// UdfpsHelper.onFingerDown() casts to V2_3, which always fails against a 2.1
+// blob, so the module never learned a finger was on the sensor and every
+// enrollment session ran into its 60 s timeout and ended in CANCELED.
+constexpr int kFodPressed = 1;
+constexpr int kFodReleased = 0;
+
+static_assert(offsetof(fingerprint_device_t, reserved) == 0xd0,
+              "vendor extCmd lives in reserved[0] at 0xd0; the HAL ABI changed");
+
+// UDFPS panel illumination.
+//
+// The official P19A panel DTS has no green local-HBM command. It defines only
+// the white 110-nit and white 1000-nit modes, so the kernel's green-500 case has
+// no command set to send. The 110-nit mode is the dim, purple-gray low-light
+// mode: at high brightness it is dimmer than the panel itself, and enrollment
+// cannot see a clean ridge image. The 1000-nit mode is the real white HBM. Use
+// it for every FOD interaction; it is a local panel mode and must never touch
+// the normal backlight. The 5-second watchdog releases it if the framework does
+// not deliver onPointerUp.
+constexpr char kDispParamPath[] = "/sys/class/mi_display/disp-DSI-0/disp_param";
+constexpr int kDispFeatureLocalHbm = 9;
+constexpr int kLocalHbmWhite1000Nit = 1;
+constexpr auto kHbmWatchdog = std::chrono::seconds(5);
+constexpr auto kHbmRetryInterval = std::chrono::milliseconds(10);
+constexpr auto kHbmReadyTimeout = std::chrono::milliseconds(500);
+constexpr auto kHbmPressGateRetryInterval = std::chrono::milliseconds(10);
+// The touch controller emits a spurious up shortly after the AOD finger-down
+// while the panel is unblanking (observed 26-252 ms). Forwarding it makes the
+// Goodix HAL abort with GF_ERROR_TOO_FAST before it can capture. Drop releases
+// that arrive inside this window; a real release or the framework's 2.5 s AOD
+// timer still passes.
+constexpr auto kMinFodHold = std::chrono::milliseconds(500);
+
+bool setLocalHbm(int value) {
+    int fd = open(kDispParamPath, O_WRONLY | O_CLOEXEC);
+    if (fd < 0) {
+        ALOGE("FOD: cannot open %s: %s", kDispParamPath, strerror(errno));
+        return false;
+    }
+
+    char buf[32];
+    int len = snprintf(buf, sizeof(buf), "%d %d\n", kDispFeatureLocalHbm, value);
+    bool ok = len > 0 && write(fd, buf, len) == len;
+    if (!ok) {
+        ALOGE("FOD: cannot set local HBM %d: %s", value, strerror(errno));
+    }
+    close(fd);
+    return ok;
+}
+
+// The Xiaomi FOD engine armed by Fingerprint::openHal() sends press_status=1
+// directly when the touch IC reports a finger, before the framework has created
+// the authentication overlay. Start the panel capture only after local HBM is
+// writable, otherwise the first frame is captured while the display is still
+// unblanking and the TEE command fails with no fingerprint image.
+using ExtCmd = int (*)(fingerprint_device_t*, int, int);
+
+ExtCmd gOriginalExtCmd = nullptr;
+std::atomic<uint32_t> gHbmPressGeneration{0};
+std::atomic<bool> gFodPressActive{false};
+std::atomic<int64_t> gLastFodPressMs{0};
+std::mutex gHbmPressGateLock;
+
+// Set by gatedExtCmd() on the same thread when it drops an early release. The
+// framework's sendFodEvent() uses this to avoid turning HBM off for a release
+// that never reached the vendor HAL.
+thread_local bool tFodReleaseSuppressed = false;
+
+int64_t steadyNowMs() {
+    return std::chrono::duration_cast<std::chrono::milliseconds>(
+                   std::chrono::steady_clock::now().time_since_epoch())
+            .count();
+}
+
+bool waitForLocalHbm() {
+    const auto deadline = std::chrono::steady_clock::now() + kHbmReadyTimeout;
+    while (std::chrono::steady_clock::now() < deadline) {
+        if (setLocalHbm(kLocalHbmWhite1000Nit)) {
+            return true;
+        }
+        std::this_thread::sleep_for(kHbmPressGateRetryInterval);
+    }
+    return false;
+}
+
+int gatedExtCmd(fingerprint_device_t* device, int cmd, int param) {
+    ExtCmd original = gOriginalExtCmd;
+    if (original == nullptr) {
+        return -ENODEV;
+    }
+
+    tFodReleaseSuppressed = false;
+
+    if (cmd == 1 && param == kFodPressed) {
+        gFodPressActive = true;
+        gLastFodPressMs = steadyNowMs();
+
+        std::lock_guard<std::mutex> lock(gHbmPressGateLock);
+        const auto generation = ++gHbmPressGeneration;
+        if (waitForLocalHbm()) {
+            ALOGD("FOD: press gate applied local HBM");
+            std::thread([generation]() {
+                std::this_thread::sleep_for(kHbmWatchdog);
+                if (gHbmPressGeneration.load() == generation) {
+                    ALOGE("FOD: press gate watchdog, forcing local HBM off");
+                    setLocalHbm(0);
+                }
+            }).detach();
+        } else {
+            ALOGE("FOD: press gate could not enable local HBM");
+        }
+    } else if (cmd == 1 && param == kFodReleased) {
+        const int64_t now = steadyNowMs();
+        const int64_t heldMs = now - gLastFodPressMs.load();
+        if (gFodPressActive.load() && gLastFodPressMs.load() != 0 &&
+            heldMs >= 0 &&
+            heldMs < std::chrono::duration_cast<std::chrono::milliseconds>(kMinFodHold)
+                              .count()) {
+            ALOGD("FOD: suppressing early release after %lld ms",
+                  static_cast<long long>(heldMs));
+            tFodReleaseSuppressed = true;
+            return 0;
+        }
+
+        ALOGD("FOD: forwarding release after %lld ms", static_cast<long long>(heldMs));
+        gFodPressActive = false;
+        ++gHbmPressGeneration;
+    }
+
+    return original(device, cmd, param);
+}
+
+}  // namespace
+
+void installHbmPressGate(fingerprint_device_t* device) {
+    if (device == nullptr) {
+        return;
+    }
+
+    ExtCmd original = reinterpret_cast<ExtCmd>(device->reserved[0]);
+    if (original == nullptr) {
+        ALOGE("FOD: cannot install press gate without vendor extCmd");
+        return;
+    }
+    if (gOriginalExtCmd != nullptr && gOriginalExtCmd != original) {
+        ALOGE("FOD: press gate already installed for another device");
+        return;
+    }
+
+    gOriginalExtCmd = original;
+    device->reserved[0] = reinterpret_cast<void*>(gatedExtCmd);
+    ALOGI("FOD: installed local-HBM press gate");
+}
