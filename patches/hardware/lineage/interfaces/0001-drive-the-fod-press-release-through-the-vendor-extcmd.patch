+// Stock HyperOS runs the Goodix FOD engine out of libmifpext.so. Its HIDL
+// service (android.hardware.biometrics.fingerprint@2.1-service-lx) links the
+// library, calls XiaomiFingerprint::getInstance()->setDevice(device) and
+// registers the IXiaomiFingerprint extension. The constructor starts
+// FodEngineCore, which is what arms the touch IC and watches fod_press_status
+// while the display is off; without it the sensor only works once the panel is
+// already on. This AIDL wrapper replaced that service, so attach the same
+// engine here.
+void attachVendorFodEngine(fingerprint_device_t* device) {
+    void* handle = dlopen("libmifpext.so", RTLD_NOW | RTLD_LOCAL);
+    if (handle == nullptr) {
+        ALOGE("FOD: cannot load libmifpext.so: %s", dlerror());
+        return;
+    }
+
+    constexpr char kGetInstance[] =
+            "_ZN6vendor6xiaomi8hardware20fingerprintextension4V1_014implementation17XiaomiFingerprint11getInstanceEv";
+    constexpr char kSetDevice[] =
+            "_ZN6vendor6xiaomi8hardware20fingerprintextension4V1_014implementation17XiaomiFingerprint9setDeviceEP18fingerprint_device";
+
+    using GetInstance = void* (*)();
+    using SetDevice = void (*)(void*, fingerprint_device_t*);
+
+    auto getInstance = reinterpret_cast<GetInstance>(dlsym(handle, kGetInstance));
+    auto setDevice = reinterpret_cast<SetDevice>(dlsym(handle, kSetDevice));
+    if (getInstance == nullptr || setDevice == nullptr) {
+        ALOGE("FOD: libmifpext.so has no XiaomiFingerprint entry points");
+        return;
+    }
+
+    void* fingerprintExtension = getInstance();
+    if (fingerprintExtension == nullptr) {
+        ALOGE("FOD: XiaomiFingerprint::getInstance() returned null");
+        return;
+    }
+
+    setDevice(fingerprintExtension, device);
+    ALOGI("FOD: vendor FOD engine attached");
+    // The engine's threads hold pointers into the library, so never dlclose it.
+}
 }  // namespace
 
