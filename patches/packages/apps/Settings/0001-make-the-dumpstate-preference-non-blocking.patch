From: uzbforce <oktamovazizbek2010@gmail.com>
Subject: [packages/apps/Settings] make the dumpstate preference non-blocking

diff --git a/src/com/android/settings/development/EnableVerboseVendorLoggingPreferenceController.java b/src/com/android/settings/development/EnableVerboseVendorLoggingPreferenceController.java
index 5e850a7eeb5..94da84a5b02 100644
--- a/src/com/android/settings/development/EnableVerboseVendorLoggingPreferenceController.java
+++ b/src/com/android/settings/development/EnableVerboseVendorLoggingPreferenceController.java
@@ -17,6 +17,7 @@
 package com.android.settings.development;
 
 import android.content.Context;
+import android.os.IBinder;
 import android.os.RemoteException;
 import android.os.ServiceManager;
 import android.util.Log;
@@ -135,8 +136,19 @@ public class EnableVerboseVendorLoggingPreferenceController
     @Nullable android.hardware.dumpstate.IDumpstateDevice getDumpstateDeviceAidlService() {
         android.hardware.dumpstate.IDumpstateDevice service = null;
         try {
-            service = android.hardware.dumpstate.IDumpstateDevice.Stub.asInterface(
-                    ServiceManager.waitForDeclaredService(DUMP_STATE_AIDL_SERVICE_NAME));
+            // Do NOT use ServiceManager.waitForDeclaredService() here. It blocks the calling
+            // thread until the declared service actually registers, and isAvailable() runs from
+            // DashboardFragment.onCreatePreferences() on the main thread, before the first frame
+            // is drawn. zephyr's vendor VINTF manifest declares
+            // android.hardware.dumpstate.IDumpstateDevice/default (dumpstate-xiaomi.xml), but no
+            // process on the device registers it, so Settings hung inside onCreate: the activity
+            // never drew and input dispatch timed out into an ANR every time Developer options
+            // was opened. getService() is a non-blocking lookup, so the preference simply
+            // reports itself unavailable, which is the correct result here.
+            final IBinder binder = ServiceManager.getService(DUMP_STATE_AIDL_SERVICE_NAME);
+            if (binder != null) {
+                service = android.hardware.dumpstate.IDumpstateDevice.Stub.asInterface(binder);
+            }
         } catch (NoSuchElementException e) {
             if (DBG) Log.e(TAG, "Get AIDL service fail: " + e);
         }
